/**
 * BSO team relay. Runs as the master's Google account (Deploy > Web app > Execute as: Me, Who has access: Anyone).
 *
 * Team laptops sign in and report through this script; it keeps everything in one private folder of the
 * master's Google Drive ("BSO Team Data"). Team members need no Google account and no sharing permissions.
 * The master console (BSO Master Console on the master's laptop) publishes the user list, limits and approval
 * decisions here, and collects the reported activity.
 *
 * Version 3: comments with @mentions go straight to each person's queue; supervisors can mark themselves away
 *   (skipped in the turns); the master can move a prospect from one supervisor to another.
 * Version 2: each person's items wait in their own queue here, so nobody needs anyone else to be online.
 * Supervisors are assigned in turn here, and each supervisor's prospects are kept so any sign-in restores them.
 *
 * Generated by BSO for one team: the line below identifies your master console. Do not share this file.
 */
var ADMIN_KEY_HASH = '__ADMIN_KEY_HASH__';
var FOLDER_NAME = 'BSO Team Data';
var RELAY_VERSION = 3;
var MAX_PULL = 150;

function doGet() {
  return out_({ ok: true, product: 'BSO relay', version: RELAY_VERSION });
}

function doPost(e) {
  var req;
  try {
    req = JSON.parse(e.postData.contents);
  } catch (x) {
    return out_({ error: 'Bad request.', code: 400 });
  }
  try {
    switch (req.action) {
      case 'ping': return out_({ ok: true, product: 'BSO relay', version: RELAY_VERSION });
      case 'login': return out_(login_(req));
      case 'sync': return out_(sync_(req));
      case 'assign': return out_(assign_(req));
      case 'restore': return out_(restore_(req));
      case 'admin_publish': requireAdmin_(req); return out_(adminPublish_(req));
      case 'admin_pull': requireAdmin_(req); return out_(adminPull_(req));
      case 'admin_post': requireAdmin_(req); return out_(adminPost_(req));
      case 'admin_reassign': requireAdmin_(req); return out_(adminReassign_(req));
    }
    return out_({ error: 'Unknown action.', code: 400 });
  } catch (err) {
    if (err && err.code) return out_({ error: err.message, code: err.code });
    return out_({ error: 'Relay error: ' + err, code: 500 });
  }
}

// ------------------------------------------------------------------ helpers

function out_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function fail_(code, message) {
  var e = new Error(message);
  e.code = code;
  throw e;
}

function hex_(bytes) {
  var s = '';
  for (var i = 0; i < bytes.length; i++) {
    var b = (bytes[i] + 256) % 256;
    s += (b < 16 ? '0' : '') + b.toString(16);
  }
  return s;
}

function unhex_(h) {
  var out = [];
  for (var i = 0; i < h.length; i += 2) {
    var b = parseInt(h.substr(i, 2), 16);
    out.push(b > 127 ? b - 256 : b);
  }
  return out;
}

function bytes_(s) {
  return Utilities.newBlob(String(s)).getBytes();
}

function sha256_(s) {
  return hex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(s), Utilities.Charset.UTF_8));
}

function hmac_(valueBytes, keyBytes) {
  return Utilities.computeHmacSha256Signature(valueBytes, keyBytes);
}

function same_(a, b) {          // constant-time string compare
  a = String(a); b = String(b);
  if (a.length !== b.length) return false;
  var d = 0;
  for (var i = 0; i < a.length; i++) d |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return d === 0;
}

function props_() {
  return PropertiesService.getScriptProperties();
}

function secret_() {
  var p = props_();
  var s = p.getProperty('SECRET');
  if (!s) {
    s = Utilities.getUuid() + Utilities.getUuid();
    p.setProperty('SECRET', s);
  }
  return s;
}

function requireAdmin_(req) {
  if (!req.admin_key || !same_(sha256_(req.admin_key), ADMIN_KEY_HASH)) fail_(401, 'Not authorised.');
}

function folder_() {
  var p = props_();
  var id = p.getProperty('FOLDER_ID');
  if (id) {
    try { return DriveApp.getFolderById(id); } catch (x) { /* deleted: make a new one */ }
  }
  var f = DriveApp.createFolder(FOLDER_NAME);
  p.setProperty('FOLDER_ID', f.getId());
  return f;
}

function sub_(name) {
  var parent = folder_();
  var it = parent.getFoldersByName(name);
  return it.hasNext() ? it.next() : parent.createFolder(name);
}

function readDoc_() {
  var cache = CacheService.getScriptCache();
  var c = cache.get('users');
  if (c) return JSON.parse(c);
  var it = folder_().getFilesByName('users.json');
  if (!it.hasNext()) return { users: {} };
  var text = it.next().getBlob().getDataAsString();
  if (text.length < 90000) cache.put('users', text, 300);
  return JSON.parse(text);
}

function findUser_(doc, name) {
  name = String(name || '').trim().toLowerCase();
  if (doc.users[name]) return { key: name, u: doc.users[name] };
  for (var k in doc.users) {
    if (doc.users[k].email && doc.users[k].email.toLowerCase() === name) return { key: k, u: doc.users[k] };
  }
  return null;
}

function passwordHash_(password, saltHex, iterations) {
  var key = unhex_(saltHex);
  var h = hmac_(bytes_(password), key);
  for (var i = 1; i < iterations; i++) h = hmac_(h, key);
  return hex_(h);
}

function tokenFor_(key, tv) {
  var base = key + '.' + tv;
  return base + '.' + hex_(hmac_(bytes_(base), bytes_(secret_())));
}

function policy_(doc, u) {
  return {
    enabled: u.status !== 'disabled', daily_cap: u.daily_cap || 0, weekly_target: u.weekly_target || 0,
    approval: u.approval || 'member', org: doc.org || 'Your team', role: u.role, name: u.name,
    grace_hours: doc.grace_hours === undefined ? 72 : doc.grace_hours, server_time: new Date().toISOString(),
    message: u.status === 'disabled' ? 'Your account is paused by your manager.' : ''
  };
}

function seen_(key, version) {
  props_().setProperty('SEEN_' + key, JSON.stringify({ at: new Date().toISOString(), version: String(version || '').substr(0, 20) }));
}

// ------------------------------------------------------------------ team laptops

function login_(req) {
  var name = String(req.username || '').trim().toLowerCase();
  var cache = CacheService.getScriptCache();
  var tk = 'fail_' + name;
  var fails = Number(cache.get(tk) || 0);
  if (fails >= 5) fail_(429, 'Too many failed attempts. Wait 15 minutes and try again.');
  var doc = readDoc_();
  var f = findUser_(doc, name);
  if (!f || !f.u.hash || !same_(passwordHash_(String(req.password || ''), f.u.salt, f.u.iter || 1500), f.u.hash)) {
    cache.put(tk, String(fails + 1), 900);
    fail_(401, 'ID or password is wrong.');
  }
  if (f.u.status === 'disabled') fail_(403, 'This account is paused. Contact your manager.');
  cache.remove(tk);
  seen_(f.key, req.version);
  return { token: tokenFor_(f.key, f.u.tv || 1), username: f.key, policy: policy_(doc, f.u) };
}

function userFromToken_(doc, token) {
  token = String(token || '');
  var b = token.lastIndexOf('.'), a = token.lastIndexOf('.', b - 1);   // key.tv.signature (the key may contain dots)
  if (a < 1 || b < 0) return null;
  var key = token.substring(0, a), tv = token.substring(a + 1, b);
  var u = doc.users[key];
  if (!u || String(u.tv || 1) !== tv) return null;              // password reset or laptop disconnected
  if (!same_(tokenFor_(key, tv), token)) return null;
  return { key: key, u: u };
}

function sync_(req) {
  var doc = readDoc_();
  var f = userFromToken_(doc, req.token);
  if (!f) fail_(401, 'unauthorized');
  var events = req.events || [], acked = req.acked || [], keep = [];
  for (var i = 0; i < events.length; i++) {
    var e = events[i] || {};
    if (e.type === '__handover') deliverHandover_(doc, f.key, e.data || {});
    else if (e.type === 'prospect_stage' && e.lead_email) setStage_(f.key, e.lead_email, e.detail);
    else if (e.type === '__comment') deliverComment_(doc, f.key, e.data || {});
    else if (e.type === '__away') props_().setProperty('AWAY_' + f.key, String((e.data || {}).until || ''));
  }
  for (var j = 0; j < acked.length; j++) {
    var a = String(acked[j]);
    if (a.indexOf('ho:q:') === 0) {                       // received from my queue: it stays in my archive
      try { DriveApp.getFileById(a.substr(5)).setTrashed(true); } catch (x) { /* already gone */ }
    } else keep.push(acked[j]);
  }
  var payload = { events: events, drafts: req.drafts || [], acked: keep, version: req.version || '' };
  if (payload.events.length || payload.drafts.length || payload.acked.length) {
    var name = f.key + '_' + new Date().getTime() + '_' + Math.floor(Math.random() * 1e6) + '.json';
    sub_('inbox').createFile(name, JSON.stringify({ user: f.key, at: new Date().toISOString(), data: payload }), 'application/json');
  }
  seen_(f.key, req.version);
  return { policy: policy_(doc, f.u), decisions: (f.u.decisions || []).concat(readQueue_(f.key)), relay_version: RELAY_VERSION };
}

// ------------------------------------------------------------------ handovers (version 2)

function userFolder_(kind, key) {
  var parent = sub_(kind);
  var it = parent.getFoldersByName(key);
  return it.hasNext() ? it.next() : parent.createFolder(key);
}

function isAway_(key, u) {
  var now = new Date().toISOString().substr(0, 10);
  var mine = props_().getProperty('AWAY_' + key) || '';
  return (mine && mine >= now) || (u.away_until && String(u.away_until) >= now);
}

function supervisors_(doc, includeAway) {
  var out = [];
  for (var k in doc.users) {
    var u = doc.users[k];
    if (u.role === 'supervisor' && u.status !== 'disabled' && (includeAway || !isAway_(k, u))) out.push({ key: k, u: u });
  }
  out.sort(function (a, b) { return String(a.u.name) < String(b.u.name) ? -1 : 1; });
  return out;
}

function supInfo_(s) {
  return { id: s.u.email, key: s.key, name: s.u.name, email: s.u.mail || s.u.email };
}

function assign_(req) {
  var doc = readDoc_();
  var f = userFromToken_(doc, req.token);
  if (!f) fail_(401, 'unauthorized');
  var sups = supervisors_(doc);
  if (!sups.length) return { supervisor: null };
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var p = props_();
    var ak = 'ASSIGN_' + sha256_(String(req.lead_email || '').toLowerCase()).substr(0, 32);
    var prev = p.getProperty(ak);
    for (var i = 0; i < sups.length; i++) if (sups[i].key === prev) return { supervisor: supInfo_(sups[i]), repeat: true };
    var best = null, bestN = 0;
    for (var j = 0; j < sups.length; j++) {
      var n = Number(p.getProperty('CNT_' + sups[j].key) || 0);
      if (best === null || n < bestN) { best = sups[j]; bestN = n; }
    }
    p.setProperty('CNT_' + best.key, String(bestN + 1));
    p.setProperty(ak, best.key);
    return { supervisor: supInfo_(best) };
  } finally {
    lock.releaseLock();
  }
}

function deliverHandover_(doc, fromKey, h) {
  var p = props_();
  var dk = 'HO_' + sha256_(fromKey + '|' + h.lead_local_id).substr(0, 32);
  if (p.getProperty(dk)) return;                          // already delivered (the laptop may send it twice)
  var target = null, sups = supervisors_(doc, true), want = String(h.supervisor || '').toLowerCase();
  for (var i = 0; i < sups.length; i++) {
    if (sups[i].key === want || String(sups[i].u.email).toLowerCase() === want || String(sups[i].u.mail || '').toLowerCase() === want) target = sups[i];
  }
  if (!target && sups.length) target = sups[0];
  if (!target) return;                                    // nobody to give it to yet: the master console still sees it
  var from = doc.users[fromKey] || {};
  var lead = h.lead || {};
  var item = { action: 'handover', lead: lead, label: h.label || '', reply: h.reply || '', intro: h.intro || '',
               thread: (h.thread || []).slice(0, 6), from: from.name || h.from_name || '', from_name: h.from_name || '', at: h.at || new Date().toISOString(),
               campaign: h.campaign || '' };
  var file = userFolder_('queues', target.key).createFile('h_' + new Date().getTime() + '_' + Math.floor(Math.random() * 1e6) + '.json',
                                                           JSON.stringify(item), 'application/json');
  var arch = 'p_' + sha256_(String(lead.email || '').toLowerCase()).substr(0, 32) + '.json';
  var folder = userFolder_('archive', target.key), it = folder.getFilesByName(arch);
  var copy = JSON.parse(JSON.stringify(item));
  copy.stage = 'new';
  var saved = JSON.stringify(copy);
  if (it.hasNext()) it.next().setContent(saved); else folder.createFile(arch, saved, 'application/json');
  p.setProperty(dk, file.getId());
}

function readQueue_(key) {
  var it = sub_('queues').getFoldersByName(key);
  if (!it.hasNext()) return [];
  var files = [], fi = it.next().getFiles();
  while (fi.hasNext()) files.push(fi.next());
  files.sort(function (a, b) { return a.getName() < b.getName() ? -1 : 1; });
  var out = [];
  for (var i = 0; i < files.length && out.length < 25; i++) {
    try {
      var item = JSON.parse(files[i].getBlob().getDataAsString());
      item.handover_id = 'q:' + files[i].getId();
      item.local_id = null;
      out.push(item);
    } catch (x) { files[i].setTrashed(true); }
  }
  return out;
}

function setStage_(key, email, stage) {
  var it = sub_('archive').getFoldersByName(key);
  if (!it.hasNext()) return;
  var fi = it.next().getFilesByName('p_' + sha256_(String(email).toLowerCase()).substr(0, 32) + '.json');
  if (!fi.hasNext()) return;
  var file = fi.next(), item = JSON.parse(file.getBlob().getDataAsString());
  item.stage = String(stage || '').substr(0, 30);
  item.stage_at = new Date().toISOString();
  file.setContent(JSON.stringify(item));
}

// ------------------------------------------------------------------ comments, reassigning (version 3)

function queueFor_(key, item) {
  userFolder_('queues', key).createFile('c_' + new Date().getTime() + '_' + Math.floor(Math.random() * 1e6) + '.json',
                                        JSON.stringify(item), 'application/json');
}

function deliverComment_(doc, fromKey, c) {
  var p = props_();
  var ck = 'CM_' + sha256_(String(c.uid || '')).substr(0, 32);
  if (!c.uid || p.getProperty(ck)) return;                // each comment once
  var from = doc.users[fromKey] || {};
  var item = { action: 'comment', uid: c.uid, lead_email: c.lead_email || '', lead_name: c.lead_name || '', company: c.company || '',
               text: String(c.text || '').substr(0, 4000), author: fromKey, author_name: from.name || fromKey, at: c.at || new Date().toISOString() };
  var to = c.to || [];
  for (var i = 0; i < to.length; i++) {
    var k = String(to[i]);
    if (k !== fromKey && doc.users[k]) queueFor_(k, item);
  }
  p.setProperty(ck, '1');
}

function adminPost_(req) {
  var doc = readDoc_(), items = req.items || [], n = 0;
  for (var i = 0; i < items.length; i++) {
    var it = items[i] || {};
    if (it.to && doc.users[it.to] && it.item) { queueFor_(it.to, it.item); n++; }
  }
  return { ok: true, delivered: n };
}

function adminReassign_(req) {
  var doc = readDoc_();
  var fromKey = String(req.from || ''), toKey = String(req.to || ''), email = String(req.lead_email || '').toLowerCase();
  if (!doc.users[toKey]) fail_(400, 'Unknown supervisor.');
  var arch = 'p_' + sha256_(email).substr(0, 32) + '.json';
  var item = req.item || null;
  var it = sub_('archive').getFoldersByName(fromKey);
  if (it.hasNext()) {
    var fi = it.next().getFilesByName(arch);
    if (fi.hasNext()) {
      var f = fi.next();
      if (!item) item = JSON.parse(f.getBlob().getDataAsString());
      f.setTrashed(true);
    }
  }
  if (!item) fail_(404, 'That prospect is not in the old supervisor\'s list.');
  item.action = 'handover';
  item.reassigned_from = (doc.users[fromKey] || {}).name || fromKey;
  var folder = userFolder_('archive', toKey), ex = folder.getFilesByName(arch);
  if (ex.hasNext()) ex.next().setContent(JSON.stringify(item)); else folder.createFile(arch, JSON.stringify(item), 'application/json');
  queueFor_(toKey, item);
  if (doc.users[fromKey]) queueFor_(fromKey, { action: 'removed', lead_email: email, to_name: (doc.users[toKey] || {}).name || toKey, at: new Date().toISOString() });
  var p = props_();
  p.setProperty('ASSIGN_' + sha256_(email).substr(0, 32), toKey);
  return { ok: true };
}

function restore_(req) {
  var doc = readDoc_();
  var f = userFromToken_(doc, req.token);
  if (!f) fail_(401, 'unauthorized');
  var it = sub_('archive').getFoldersByName(f.key);
  var items = [];
  if (it.hasNext()) {
    var fi = it.next().getFiles();
    while (fi.hasNext() && items.length < 1000) {
      try { items.push(JSON.parse(fi.next().getBlob().getDataAsString())); } catch (x) { /* skip */ }
    }
  }
  return { items: items, relay_version: RELAY_VERSION };
}

// ------------------------------------------------------------------ master console

function adminPublish_(req) {
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var text = JSON.stringify(req.doc || { users: {} });
    var it = folder_().getFilesByName('users.json');
    if (it.hasNext()) it.next().setContent(text);
    else folder_().createFile('users.json', text, 'application/json');
    var cache = CacheService.getScriptCache();
    if (text.length < 90000) cache.put('users', text, 300); else cache.remove('users');
    return { ok: true };
  } finally {
    lock.releaseLock();
  }
}

function adminPull_(req) {
  var inbox = sub_('inbox');
  var done = req.done || [];
  for (var i = 0; i < done.length; i++) {
    try { DriveApp.getFileById(done[i]).setTrashed(true); } catch (x) { /* already gone */ }
  }
  var files = [];
  var it = inbox.getFiles();
  while (it.hasNext()) files.push(it.next());
  files.sort(function (a, b) { return a.getDateCreated() - b.getDateCreated() || (a.getName() < b.getName() ? -1 : 1); });   // oldest first
  var items = [];
  for (var j = 0; j < files.length && items.length < MAX_PULL; j++) {
    try {
      items.push({ id: files[j].getId(), body: JSON.parse(files[j].getBlob().getDataAsString()) });
    } catch (x) { files[j].setTrashed(true); }
  }
  var all = props_().getProperties(), seen = {};
  for (var k in all) if (k.indexOf('SEEN_') === 0) seen[k.substr(5)] = JSON.parse(all[k]);
  return { items: items, more: files.length > items.length, seen: seen, relay_version: RELAY_VERSION };
}
