/**
 * BSO team relay. Runs as the master's Google account (Deploy > Web app > Execute as: Me, Who has access: Anyone).
 *
 * Team laptops sign in and report through this script; it keeps everything in one private folder of the
 * master's Google Drive ("BSO Team Data"). Team members need no Google account and no sharing permissions.
 * The master console (BSO Master Console on the master's laptop) publishes the user list, limits and approval
 * decisions here, and collects the reported activity.
 *
 * Generated by BSO for one team: the line below identifies your master console. Do not share this file.
 */
var ADMIN_KEY_HASH = '__ADMIN_KEY_HASH__';
var FOLDER_NAME = 'BSO Team Data';
var RELAY_VERSION = 1;
var MAX_PULL = 150;

function doGet() {
  return out_({ ok: true, product: 'BSO relay', version: RELAY_VERSION });
}

function doPost(e) {
  var req;
  try {
    req = JSON.parse(e.postData.contents);
  } catch (x) {
    return out_({ error: 'Bad request.', code: 400 });
  }
  try {
    switch (req.action) {
      case 'ping': return out_({ ok: true, product: 'BSO relay', version: RELAY_VERSION });
      case 'login': return out_(login_(req));
      case 'sync': return out_(sync_(req));
      case 'admin_publish': requireAdmin_(req); return out_(adminPublish_(req));
      case 'admin_pull': requireAdmin_(req); return out_(adminPull_(req));
    }
    return out_({ error: 'Unknown action.', code: 400 });
  } catch (err) {
    if (err && err.code) return out_({ error: err.message, code: err.code });
    return out_({ error: 'Relay error: ' + err, code: 500 });
  }
}

// ------------------------------------------------------------------ helpers

function out_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function fail_(code, message) {
  var e = new Error(message);
  e.code = code;
  throw e;
}

function hex_(bytes) {
  var s = '';
  for (var i = 0; i < bytes.length; i++) {
    var b = (bytes[i] + 256) % 256;
    s += (b < 16 ? '0' : '') + b.toString(16);
  }
  return s;
}

function unhex_(h) {
  var out = [];
  for (var i = 0; i < h.length; i += 2) {
    var b = parseInt(h.substr(i, 2), 16);
    out.push(b > 127 ? b - 256 : b);
  }
  return out;
}

function bytes_(s) {
  return Utilities.newBlob(String(s)).getBytes();
}

function sha256_(s) {
  return hex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(s), Utilities.Charset.UTF_8));
}

function hmac_(valueBytes, keyBytes) {
  return Utilities.computeHmacSha256Signature(valueBytes, keyBytes);
}

function same_(a, b) {          // constant-time string compare
  a = String(a); b = String(b);
  if (a.length !== b.length) return false;
  var d = 0;
  for (var i = 0; i < a.length; i++) d |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return d === 0;
}

function props_() {
  return PropertiesService.getScriptProperties();
}

function secret_() {
  var p = props_();
  var s = p.getProperty('SECRET');
  if (!s) {
    s = Utilities.getUuid() + Utilities.getUuid();
    p.setProperty('SECRET', s);
  }
  return s;
}

function requireAdmin_(req) {
  if (!req.admin_key || !same_(sha256_(req.admin_key), ADMIN_KEY_HASH)) fail_(401, 'Not authorised.');
}

function folder_() {
  var p = props_();
  var id = p.getProperty('FOLDER_ID');
  if (id) {
    try { return DriveApp.getFolderById(id); } catch (x) { /* deleted: make a new one */ }
  }
  var f = DriveApp.createFolder(FOLDER_NAME);
  p.setProperty('FOLDER_ID', f.getId());
  return f;
}

function sub_(name) {
  var parent = folder_();
  var it = parent.getFoldersByName(name);
  return it.hasNext() ? it.next() : parent.createFolder(name);
}

function readDoc_() {
  var cache = CacheService.getScriptCache();
  var c = cache.get('users');
  if (c) return JSON.parse(c);
  var it = folder_().getFilesByName('users.json');
  if (!it.hasNext()) return { users: {} };
  var text = it.next().getBlob().getDataAsString();
  if (text.length < 90000) cache.put('users', text, 300);
  return JSON.parse(text);
}

function findUser_(doc, name) {
  name = String(name || '').trim().toLowerCase();
  if (doc.users[name]) return { key: name, u: doc.users[name] };
  for (var k in doc.users) {
    if (doc.users[k].email && doc.users[k].email.toLowerCase() === name) return { key: k, u: doc.users[k] };
  }
  return null;
}

function passwordHash_(password, saltHex, iterations) {
  var key = unhex_(saltHex);
  var h = hmac_(bytes_(password), key);
  for (var i = 1; i < iterations; i++) h = hmac_(h, key);
  return hex_(h);
}

function tokenFor_(key, tv) {
  var base = key + '.' + tv;
  return base + '.' + hex_(hmac_(bytes_(base), bytes_(secret_())));
}

function policy_(doc, u) {
  return {
    enabled: u.status !== 'disabled', daily_cap: u.daily_cap || 0, weekly_target: u.weekly_target || 0,
    approval: u.approval || 'member', org: doc.org || 'Your team', role: u.role, name: u.name,
    grace_hours: doc.grace_hours === undefined ? 72 : doc.grace_hours, server_time: new Date().toISOString(),
    message: u.status === 'disabled' ? 'Your account is paused by your manager.' : ''
  };
}

function seen_(key, version) {
  props_().setProperty('SEEN_' + key, JSON.stringify({ at: new Date().toISOString(), version: String(version || '').substr(0, 20) }));
}

// ------------------------------------------------------------------ team laptops

function login_(req) {
  var name = String(req.username || '').trim().toLowerCase();
  var cache = CacheService.getScriptCache();
  var tk = 'fail_' + name;
  var fails = Number(cache.get(tk) || 0);
  if (fails >= 5) fail_(429, 'Too many failed attempts. Wait 15 minutes and try again.');
  var doc = readDoc_();
  var f = findUser_(doc, name);
  if (!f || !f.u.hash || !same_(passwordHash_(String(req.password || ''), f.u.salt, f.u.iter || 1500), f.u.hash)) {
    cache.put(tk, String(fails + 1), 900);
    fail_(401, 'ID or password is wrong.');
  }
  if (f.u.status === 'disabled') fail_(403, 'This account is paused. Contact your manager.');
  cache.remove(tk);
  seen_(f.key, req.version);
  return { token: tokenFor_(f.key, f.u.tv || 1), username: f.key, policy: policy_(doc, f.u) };
}

function userFromToken_(doc, token) {
  token = String(token || '');
  var b = token.lastIndexOf('.'), a = token.lastIndexOf('.', b - 1);   // key.tv.signature (the key may contain dots)
  if (a < 1 || b < 0) return null;
  var key = token.substring(0, a), tv = token.substring(a + 1, b);
  var u = doc.users[key];
  if (!u || String(u.tv || 1) !== tv) return null;              // password reset or laptop disconnected
  if (!same_(tokenFor_(key, tv), token)) return null;
  return { key: key, u: u };
}

function sync_(req) {
  var doc = readDoc_();
  var f = userFromToken_(doc, req.token);
  if (!f) fail_(401, 'unauthorized');
  var payload = { events: req.events || [], drafts: req.drafts || [], acked: req.acked || [], version: req.version || '' };
  if (payload.events.length || payload.drafts.length || payload.acked.length) {
    var name = f.key + '_' + new Date().getTime() + '_' + Math.floor(Math.random() * 1e6) + '.json';
    sub_('inbox').createFile(name, JSON.stringify({ user: f.key, at: new Date().toISOString(), data: payload }), 'application/json');
  }
  seen_(f.key, req.version);
  return { policy: policy_(doc, f.u), decisions: f.u.decisions || [] };
}

// ------------------------------------------------------------------ master console

function adminPublish_(req) {
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var text = JSON.stringify(req.doc || { users: {} });
    var it = folder_().getFilesByName('users.json');
    if (it.hasNext()) it.next().setContent(text);
    else folder_().createFile('users.json', text, 'application/json');
    var cache = CacheService.getScriptCache();
    if (text.length < 90000) cache.put('users', text, 300); else cache.remove('users');
    return { ok: true };
  } finally {
    lock.releaseLock();
  }
}

function adminPull_(req) {
  var inbox = sub_('inbox');
  var done = req.done || [];
  for (var i = 0; i < done.length; i++) {
    try { DriveApp.getFileById(done[i]).setTrashed(true); } catch (x) { /* already gone */ }
  }
  var files = [];
  var it = inbox.getFiles();
  while (it.hasNext()) files.push(it.next());
  files.sort(function (a, b) { return a.getName() < b.getName() ? -1 : 1; });
  var items = [];
  for (var j = 0; j < files.length && items.length < MAX_PULL; j++) {
    try {
      items.push({ id: files[j].getId(), body: JSON.parse(files[j].getBlob().getDataAsString()) });
    } catch (x) { files[j].setTrashed(true); }
  }
  var all = props_().getProperties(), seen = {};
  for (var k in all) if (k.indexOf('SEEN_') === 0) seen[k.substr(5)] = JSON.parse(all[k]);
  return { items: items, more: files.length > items.length, seen: seen, relay_version: RELAY_VERSION };
}
